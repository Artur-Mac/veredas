{
  "$schema": "https://tr.designtokens.org/format/",
  "$metadata": {
    "name": "VEREDA Design System Tokens",
    "version": "3.1.0",
    "format": "W3C Design Tokens Community Group (DTCG)",
    "typographyStrategy": "Zero monospace. Wordmark defaults to Switzer Bold (700) with Geist Serif Triangle optical-bold (+0.45px stroke) option. Geist Serif Triangle (>= 24px, weight 400) for editorial headlines; Switzer (default) or Geist (1-token swap) with font-variant-numeric: tabular-nums for all UI copy and metrics. Cadastral tags hidden in Layer 3 only.",
    "geometryRule": "Architectural restraint (anti-vibecode): max 12px outer card radius, 8px buttons, zero nested boxes, 3px left accent status rules instead of AI dot-pills.",
    "wcagCompliance": "All semantic text/background pairs verified >= 4.88:1 (WCAG 2.1 AA); graphical accents >= 3.23:1 (WCAG 1.4.11)."
  },
  "primitive": {
    "color": {
      "sand": {
        "1": { "$type": "color", "$value": "#FCFBF9", "$description": "Elevated warm paper surface (Radix step 1)" },
        "2": { "$type": "color", "$value": "#F6F4EF", "$description": "Porcelain primary canvas (Radix step 2)" },
        "3": { "$type": "color", "$value": "#ECEAE3", "$description": "Tactile sand control fill (Radix step 3)" },
        "4": { "$type": "color", "$value": "#E2DFD6", "$description": "Tactile sand hover fill (Radix step 4)" },
        "5": { "$type": "color", "$value": "#D8D3C8", "$description": "Tactile sand active/pressed fill (Radix step 5)" },
        "6": { "$type": "color", "$value": "#E4DFD5", "$description": "Hairline 1px non-interactive structural border (Radix step 6)" },
        "7": { "$type": "color", "$value": "#CCC6B9", "$description": "Interactive input & framed control border (Radix step 7)" },
        "8": { "$type": "color", "$value": "#B3AC9D", "$description": "Interactive border hover state (Radix step 8)" },
        "9": { "$type": "color", "$value": "#787E7B", "$description": "Neutral stone indicator fill (Radix step 9)" },
        "10": { "$type": "color", "$value": "#656D6A", "$description": "Neutral stone indicator hover (Radix step 10)" },
        "11": { "$type": "color", "$value": "#5A6663", "$description": "Muted metadata ink — 5.43:1 on #F6F4EF, 5.78:1 on #FCFBF9 (Radix step 11)" },
        "12": { "$type": "color", "$value": "#42504D", "$description": "Secondary body ink — 7.68:1 on #F6F4EF, 8.17:1 on #FCFBF9 (Radix step 12)" }
      },
      "forest": {
        "9": { "$type": "color", "$value": "#142D2D", "$description": "Deep Forest primary brand ink & dark surface — 14.07:1 on #FCFBF9" },
        "10": { "$type": "color", "$value": "#1D3E3E", "$description": "Deep Forest hover surface" },
        "11": { "$type": "color", "$value": "#275252", "$description": "Deep Forest active surface" },
        "mutedOnDark": { "$type": "color", "$value": "#C8D4D1", "$description": "Soft stone text on Deep Forest — 9.56:1 AA/AAA" },
        "borderOnDark": { "$type": "color", "$value": "#254848", "$description": "Subtle hairline on Deep Forest dark cards" }
      },
      "solar": {
        "2": { "$type": "color", "$value": "#FDF0E8", "$description": "Subtle solar highlight fill" },
        "6": { "$type": "color", "$value": "#F3C3A8", "$description": "Subtle solar hairline" },
        "8": { "$type": "color", "$value": "#F47745", "$description": "Solar icon/text accent on Deep Forest (#142D2D) — 5.25:1 AA" },
        "9": { "$type": "color", "$value": "#EA580C", "$description": "Signature VEREDA Portal & graphic DataViz orange — 3.44:1 graphic on light, 4.09:1 on dark" },
        "10": { "$type": "color", "$value": "#C44312", "$description": "WCAG AA primary CTA button fill with #FCFBF9 label — 4.88:1" },
        "11": { "$type": "color", "$value": "#A9380E", "$description": "WCAG AA primary CTA hover fill — 6.23:1" },
        "12": { "$type": "color", "$value": "#BC4010", "$description": "WCAG AA small solar text on #FCFBF9 (5.23:1) and #F6F4EF (4.93:1)" }
      },
      "teal": {
        "2": { "$type": "color", "$value": "#E6F3F1", "$description": "Favorable soft surface" },
        "6": { "$type": "color", "$value": "#B6DDD8", "$description": "Favorable hairline border" },
        "9": { "$type": "color", "$value": "#0F766E", "$description": "Mangrove Teal DataViz graphic fill — 5.29:1" },
        "11": { "$type": "color", "$value": "#0F6E65", "$description": "Favorable semantic ink & accent rule — 5.91:1 on #FCFBF9, 5.37:1 on #E6F3F1" }
      },
      "ochre": {
        "2": { "$type": "color", "$value": "#FDF3E3", "$description": "Caution soft surface" },
        "6": { "$type": "color", "$value": "#EED3A7", "$description": "Caution hairline border" },
        "9": { "$type": "color", "$value": "#C97A16", "$description": "Caution graphic accent rule/bar ONLY (3.23:1 graphic on #FCFBF9)" },
        "11": { "$type": "color", "$value": "#945306", "$description": "Caution semantic ink — 5.80:1 on #FCFBF9, 5.46:1 on #FDF3E3" }
      },
      "terracotta": {
        "2": { "$type": "color", "$value": "#FBECEB", "$description": "Critical soft surface" },
        "6": { "$type": "color", "$value": "#EBC1BC", "$description": "Critical hairline border" },
        "9": { "$type": "color", "$value": "#C43C2E", "$description": "Critical graphic accent rule — 4.74:1" },
        "11": { "$type": "color", "$value": "#B33124", "$description": "Critical semantic ink — 6.00:1 on #FCFBF9, 5.41:1 on #FBECEB" }
      },
      "cadastral": {
        "2": { "$type": "color", "$value": "#EAF1F7", "$description": "Official record soft surface" },
        "6": { "$type": "color", "$value": "#BED3E5", "$description": "Official record hairline border" },
        "9": { "$type": "color", "$value": "#2E5A85", "$description": "Official graphic line/marker — 6.95:1" },
        "11": { "$type": "color", "$value": "#1E507B", "$description": "Official link & Layer 3 trigger ink — 8.16:1 on #FCFBF9, 7.40:1 on #EAF1F7" }
      }
    },
    "fontFamily": {
      "display": { "$type": "fontFamily", "$value": ["Geist Serif Triangle", "Georgia", "serif"], "$description": "Geist Serif Triangle (>= 24px) for editorial headlines; optional optical bold (+0.45px stroke) for wordmark test." },
      "sans": { "$type": "fontFamily", "$value": ["Switzer", "-apple-system", "BlinkMacSystemFont", "sans-serif"], "$description": "Primary humanist-grotesque sans (Fontshare) & default bold wordmark. Supports tabular-nums." },
      "sansAlternate": { "$type": "fontFamily", "$value": ["Geist", "-apple-system", "BlinkMacSystemFont", "sans-serif"], "$description": "1-token geometric sans swap (Vercel Geist Sans). Supports tabular-nums." }
    },
    "fontWeight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "medium": { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold": { "$type": "fontWeight", "$value": 700 },
      "extrabold": { "$type": "fontWeight", "$value": 800 }
    },
    "fontSize": {
      "xs": { "$type": "dimension", "$value": "11px" },
      "sm": { "$type": "dimension", "$value": "12px" },
      "md": { "$type": "dimension", "$value": "13.5px" },
      "base": { "$type": "dimension", "$value": "15px" },
      "lg": { "$type": "dimension", "$value": "17px" },
      "xl": { "$type": "dimension", "$value": "20px" },
      "2xl": { "$type": "dimension", "$value": "24px" },
      "3xl": { "$type": "dimension", "$value": "30px" },
      "4xl": { "$type": "dimension", "$value": "38px" },
      "5xl": { "$type": "dimension", "$value": "48px" }
    },
    "lineHeight": {
      "tight": { "$type": "number", "$value": 1.08 },
      "snug": { "$type": "number", "$value": 1.2 },
      "normal": { "$type": "number", "$value": 1.4 },
      "relaxed": { "$type": "number", "$value": 1.55 }
    },
    "letterSpacing": {
      "displayTight": { "$type": "dimension", "$value": "-0.025em" },
      "tight": { "$type": "dimension", "$value": "-0.02em" },
      "normal": { "$type": "dimension", "$value": "0em" },
      "kicker": { "$type": "dimension", "$value": "0.06em" },
      "wordmark": { "$type": "dimension", "$value": "0.16em" }
    },
    "space": {
      "1": { "$type": "dimension", "$value": "4px" },
      "2": { "$type": "dimension", "$value": "8px" },
      "3": { "$type": "dimension", "$value": "12px" },
      "4": { "$type": "dimension", "$value": "16px" },
      "5": { "$type": "dimension", "$value": "20px" },
      "6": { "$type": "dimension", "$value": "24px" },
      "8": { "$type": "dimension", "$value": "32px" },
      "10": { "$type": "dimension", "$value": "40px" },
      "12": { "$type": "dimension", "$value": "48px" },
      "16": { "$type": "dimension", "$value": "64px" }
    },
    "radius": {
      "xs": { "$type": "dimension", "$value": "4px" },
      "sm": { "$type": "dimension", "$value": "6px" },
      "md": { "$type": "dimension", "$value": "8px" },
      "lg": { "$type": "dimension", "$value": "10px" },
      "xl": { "$type": "dimension", "$value": "12px" },
      "pill": { "$type": "dimension", "$value": "9999px", "$description": "Reserved strictly for compact segmented toggles and floating phone bottom dock" }
    },
    "borderWidth": {
      "hairline": { "$type": "dimension", "$value": "1px" },
      "medium": { "$type": "dimension", "$value": "1.5px" },
      "focus": { "$type": "dimension", "$value": "2px" },
      "accentRule": { "$type": "dimension", "$value": "3px", "$description": "Left editorial status bar replacing rounded AI dot-pills" }
    },
    "shadow": {
      "none": { "$type": "string", "$value": "none", "$description": "Default for all resting content cards (paper-first surface polarity)" },
      "pillActive": {
        "$type": "shadow",
        "$value": { "color": "rgba(20, 45, 45, 0.08)", "offsetX": "0px", "offsetY": "1px", "blur": "3px", "spread": "0px" }
      },
      "floatingNav": {
        "$type": "shadow",
        "$value": { "color": "rgba(20, 45, 45, 0.22)", "offsetX": "0px", "offsetY": "12px", "blur": "28px", "spread": "-6px" }
      },
      "modalDrawer": {
        "$type": "shadow",
        "$value": { "color": "rgba(20, 45, 45, 0.24)", "offsetX": "0px", "offsetY": "20px", "blur": "48px", "spread": "-12px" }
      }
    },
    "duration": {
      "fast": { "$type": "duration", "$value": "150ms" },
      "base": { "$type": "duration", "$value": "220ms" },
      "chart": { "$type": "duration", "$value": "420ms" }
    },
    "easing": {
      "standard": { "$type": "cubicBezier", "$value": [0.22, 1, 0.36, 1] }
    },
    "breakpoint": {
      "mobileApp": { "$type": "dimension", "$value": "390px" },
      "tablet": { "$type": "dimension", "$value": "768px" },
      "webDesktop": { "$type": "dimension", "$value": "1440px" },
      "socialInstagramWidth": { "$type": "dimension", "$value": "1080px" },
      "socialInstagramHeight": { "$type": "dimension", "$value": "1350px" }
    }
  },
  "semantic": {
    "color": {
      "surface": {
        "canvas": { "$type": "color", "$value": "{primitive.color.sand.2}", "$description": "Level-0 warm porcelain canvas (60% of viewport)" },
        "elevated": { "$type": "color", "$value": "{primitive.color.sand.1}", "$description": "Level-1 audit sheets and cards" },
        "subtle": { "$type": "color", "$value": "{primitive.color.sand.3}", "$description": "Sand switches, track rails, and subtle backgrounds" },
        "subtleHover": { "$type": "color", "$value": "{primitive.color.sand.4}" },
        "dark": { "$type": "color", "$value": "{primitive.color.forest.9}", "$description": "Dark brand anchor (16-symbol dark mode, floating dock, IG cover)" }
      },
      "ink": {
        "primary": { "$type": "color", "$value": "{primitive.color.forest.9}", "$description": "14.07:1 on elevated, 13.24:1 on canvas (AAA)" },
        "secondary": { "$type": "color", "$value": "{primitive.color.sand.12}", "$description": "8.17:1 on elevated, 7.68:1 on canvas (AAA)" },
        "muted": { "$type": "color", "$value": "{primitive.color.sand.11}", "$description": "5.78:1 on elevated, 5.43:1 on canvas, 4.96:1 on subtle (AA)" },
        "onDark": { "$type": "color", "$value": "{primitive.color.sand.1}", "$description": "14.07:1 on forest.9 (AAA)" },
        "onDarkMuted": { "$type": "color", "$value": "{primitive.color.forest.mutedOnDark}", "$description": "9.56:1 on forest.9 (AAA)" }
      },
      "border": {
        "hairline": { "$type": "color", "$value": "{primitive.color.sand.6}", "$description": "1px structural card and matrix divider" },
        "strong": { "$type": "color", "$value": "{primitive.color.sand.7}", "$description": "Input framing and outer card border" },
        "focus": { "$type": "color", "$value": "{primitive.color.cadastral.11}", "$description": "2px visible focus ring — 8.16:1 on elevated" },
        "onDark": { "$type": "color", "$value": "{primitive.color.forest.borderOnDark}" }
      },
      "brand": {
        "forest": { "$type": "color", "$value": "{primitive.color.forest.9}" },
        "forestHover": { "$type": "color", "$value": "{primitive.color.forest.10}" },
        "solarMark": { "$type": "color", "$value": "{primitive.color.solar.9}", "$description": "Portal mark and DataViz graphic focal color" },
        "solarCta": { "$type": "color", "$value": "{primitive.color.solar.10}", "$description": "Primary CTA fill with ink.onDark text (4.88:1 AA)" },
        "solarCtaHover": { "$type": "color", "$value": "{primitive.color.solar.11}" },
        "solarText": { "$type": "color", "$value": "{primitive.color.solar.12}", "$description": "Small solar text on light paper (5.23:1 AA)" },
        "solarOnDark": { "$type": "color", "$value": "{primitive.color.solar.8}", "$description": "Solar icon/accent text on Deep Forest (5.25:1 AA)" },
        "solarTint": { "$type": "color", "$value": "{primitive.color.solar.2}" }
      },
      "status": {
        "favorable": {
          "text": { "$type": "color", "$value": "{primitive.color.teal.11}", "$description": "5.91:1 on elevated / 5.37:1 on tint (AA)" },
          "bg": { "$type": "color", "$value": "{primitive.color.teal.2}" },
          "border": { "$type": "color", "$value": "{primitive.color.teal.6}" },
          "graphic": { "$type": "color", "$value": "{primitive.color.teal.9}" },
          "onSolid": { "$type": "color", "$value": "{primitive.color.sand.1}" }
        },
        "caution": {
          "text": { "$type": "color", "$value": "{primitive.color.ochre.11}", "$description": "5.80:1 on elevated / 5.46:1 on tint (AA)" },
          "bg": { "$type": "color", "$value": "{primitive.color.ochre.2}" },
          "border": { "$type": "color", "$value": "{primitive.color.ochre.6}" },
          "graphic": { "$type": "color", "$value": "{primitive.color.ochre.9}", "$description": "3.23:1 graphic on elevated (WCAG 1.4.11)" },
          "onSolid": { "$type": "color", "$value": "{primitive.color.sand.1}" }
        },
        "critical": {
          "text": { "$type": "color", "$value": "{primitive.color.terracotta.11}", "$description": "6.00:1 on elevated / 5.41:1 on tint (AA)" },
          "bg": { "$type": "color", "$value": "{primitive.color.terracotta.2}" },
          "border": { "$type": "color", "$value": "{primitive.color.terracotta.6}" },
          "graphic": { "$type": "color", "$value": "{primitive.color.terracotta.9}" },
          "onSolid": { "$type": "color", "$value": "{primitive.color.sand.1}" }
        },
        "official": {
          "text": { "$type": "color", "$value": "{primitive.color.cadastral.11}", "$description": "8.16:1 on elevated / 7.40:1 on tint (AAA)" },
          "bg": { "$type": "color", "$value": "{primitive.color.cadastral.2}" },
          "border": { "$type": "color", "$value": "{primitive.color.cadastral.6}" },
          "graphic": { "$type": "color", "$value": "{primitive.color.cadastral.9}" },
          "onSolid": { "$type": "color", "$value": "{primitive.color.sand.1}" }
        },
        "noReading": {
          "text": { "$type": "color", "$value": "{primitive.color.sand.11}", "$description": "Sem leitura state — 4.96:1 on sand.3 (AA)" },
          "bg": { "$type": "color", "$value": "{primitive.color.sand.3}" },
          "border": { "$type": "color", "$value": "{primitive.color.sand.7}" },
          "graphic": { "$type": "color", "$value": "{primitive.color.sand.9}" }
        }
      },
      "dataviz": {
        "track": { "$type": "color", "$value": "{primitive.color.sand.3}" },
        "neutralBar": { "$type": "color", "$value": "{primitive.color.forest.9}" },
        "medianBar": { "$type": "color", "$value": "{primitive.color.teal.11}" },
        "askBar": { "$type": "color", "$value": "{primitive.color.solar.9}" },
        "breezeVector": { "$type": "color", "$value": "{primitive.color.teal.11}" },
        "sunRay": { "$type": "color", "$value": "{primitive.color.solar.9}" },
        "waterReference": { "$type": "color", "$value": "{primitive.color.cadastral.9}" },
        "shadowCast": { "$type": "color", "$value": "rgba(20, 45, 45, 0.16)" }
      }
    },
    "typography": {
      "wordmark": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{primitive.fontFamily.sans}",
          "fontSize": "{primitive.fontSize.lg}",
          "fontWeight": "{primitive.fontWeight.bold}",
          "lineHeight": "{primitive.lineHeight.tight}",
          "letterSpacing": "{primitive.letterSpacing.wordmark}"
        },
        "$description": "Primary brand wordmark (Switzer Bold 700; alternate optical-bold Geist Serif Triangle tested in showcase)"
      },
      "display": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{primitive.fontFamily.display}",
          "fontSize": "{primitive.fontSize.4xl}",
          "fontWeight": "{primitive.fontWeight.regular}",
          "lineHeight": "{primitive.lineHeight.tight}",
          "letterSpacing": "{primitive.letterSpacing.displayTight}"
        },
        "$description": "Landing Hero & Instagram Cover (>= 24px floor enforced for Geist Serif Triangle hairlines)"
      },
      "heading": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{primitive.fontFamily.display}",
