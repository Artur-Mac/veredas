      "radius": { "$type": "dimension", "$value": "{primitive.radius.xl}" },
      "padding": { "$type": "dimension", "$value": "{semantic.spacing.cardPadding}" },
      "shadow": { "$type": "string", "$value": "{primitive.shadow.none}" }
    },
