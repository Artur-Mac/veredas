      }
    },
    "disclosureLayer3": {
      "triggerMinHeight": { "$type": "dimension", "$value": "{semantic.spacing.touchTargetMin}" },
      "topBorder": { "$type": "color", "$value": "{semantic.color.border.hairline}" },
