          "fontWeight": "{primitive.fontWeight.medium}",
          "lineHeight": "{primitive.lineHeight.normal}",
          "letterSpacing": "{primitive.letterSpacing.normal}"
        }
      },
      "cadastralTagLayer3": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{primitive.fontFamily.sans}",
          "fontSize": "{primitive.fontSize.xs}",
          "fontWeight": "{primitive.fontWeight.semibold}",
          "lineHeight": "{primitive.lineHeight.snug}",
          "letterSpacing": "{primitive.letterSpacing.kicker}",
          "textTransform": "uppercase",
          "fontVariantNumeric": "tabular-nums"
        },
        "$description": "Hidden by default — displayed exclusively inside Layer 3 technical proof (DSQFL, SOL-NASC, ITBI-2026)"
      },
      "metricHero": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{primitive.fontFamily.sans}",
          "fontSize": "{primitive.fontSize.3xl}",
