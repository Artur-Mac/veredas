          "fontWeight": "{primitive.fontWeight.regular}",
          "lineHeight": "{primitive.lineHeight.snug}",
          "letterSpacing": "{primitive.letterSpacing.tight}"
        },
        "$description": "Mobile Screen Title & Editorial Section Headline (24px minimum)"
      },
      "subheading": {
        "$type": "typography",
        "$value": {
