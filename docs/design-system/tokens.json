    "navPill": {
      "containerBg": { "$type": "color", "$value": "{semantic.color.brand.forest}" },
      "activePillBg": { "$type": "color", "$value": "{semantic.color.surface.elevated}" },
      "activePillText": { "$type": "color", "$value": "{semantic.color.ink.primary}" },
      "inactiveText": { "$type": "color", "$value": "{semantic.color.ink.onDarkMuted}" },
      "shadow": { "$type": "shadow", "$value": "{primitive.shadow.floatingNav}" }
    },
    "filterChip": {
      "minHeight": { "$type": "dimension", "$value": "{semantic.spacing.touchTargetMin}" },
      "radius": { "$type": "dimension", "$value": "{primitive.radius.md}" },
      "bgRest": { "$type": "color", "$value": "{semantic.color.surface.subtle}" },
      "bgActive": { "$type": "color", "$value": "{semantic.color.brand.forest}" },
      "textRest": { "$type": "color", "$value": "{semantic.color.ink.primary}" },
      "textActive": { "$type": "color", "$value": "{semantic.color.ink.onDark}" }
    }
  }
}
