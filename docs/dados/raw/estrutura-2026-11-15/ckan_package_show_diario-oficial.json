{"help": "https://dados.recife.pe.gov.br:443/api/3/action/help_show?name=package_show", "success": true, "result": {"author": "Emprel", "author_email": "dadosabertos@recife.pe.gov.br", "creator_user_id": "29a76a44-2c7d-4ed1-8a05-fb36e745dccc", "id": "12578535-6cf0-4097-94fa-ff6ec3d51988", "isopen": true, "license_id": "odc-odbl", "license_title": "Licen\u00e7a Aberta para Bases de Dados (ODbL) do Open Data Commons", "license_url": "http://www.opendefinition.org/licenses/odc-odbl", "maintainer": "Emprel", "maintainer_email": "dadosabertos@recife.pe.gov.br", "metadata_created": "2026-02-27T12:22:29.144452", "metadata_modified": "2026-11-11T18:23:18.728314", "name": "diario-oficial", "notes": "O Di\u00e1rio Oficial \u00e9 um jornal oficial dos \u00f3rg\u00e3os p\u00fablicos municipais. O governo do Recife precisa tornar p\u00fablico suas a\u00e7\u00f5es, decis\u00f5es, resolu\u00e7\u00f5es ou qualquer outro assunto de interesse da sociedade.\r\nDisponibilizado os dados de 2004 \u00e0 2016", "num_resources": 35, "num_tags": 4, "organization": {"id": "3bbff3cf-0111-4ce7-8e3a-d8859135340b", "name": "secretaria-de-governo", "title": "Secretaria de Governo e Participa\u00e7\u00e3o Social", "type": "organization", "description": "A Secretaria de Governo e Participa\u00e7\u00e3o Social atua no relacionamento com a sociedade civil e gerencia os mecanismos de Participa\u00e7\u00e3o Social da Prefeitura do Recife. \u00c9 seu papel monitorar e promover a transpar\u00eancia da gest\u00e3o, bem como coordenar a pol\u00edtica de comunica\u00e7\u00e3o institucional do munic\u00edpio. Tamb\u00e9m exerce a coordena\u00e7\u00e3o das atividades entre os \u00f3rg\u00e3os e entidades do Poder Executivo Municipal concernentes aos aspectos administrativos, pol\u00edticos, c\u00edvicos e de representa\u00e7\u00e3o, al\u00e9m de publicar os atos, despachos e expedientes da Prefeitura.", "image_url": "https://dados.recife.pe.gov.br/base/images/recife/organizacao-saude.png", "created": "2026-02-25T11:46:45.130495", "is_organization": true, "approval_status": "approved", "state": "active"}, "owner_org": "3bbff3cf-0111-4ce7-8e3a-d8859135340b", "private": false, "state": "active", "title": "Di\u00e1rio Oficial", "type": "dataset", "url": "", "version": "", "extras": [{"key": "Categoria", "value": "http://vocab.e.gov.br/id/governo#outros-administracao"}, {"key": "Fonte", "value": "Secretaria do Governo"}, {"key": "Frequ\u00eancia de atualiza\u00e7\u00e3o", "value": "Mensal"}], "groups": [{"description": "", "display_name": "Governo e Pol\u00edtica", "id": "a5e2b08b-4c74-4cab-8303-b0b48b178e4d", "image_display_url": "", "name": "governo-e-politica", "title": "Governo e Pol\u00edtica"}], "resources": [{"cache_last_updated": null, "cache_url": null, "created": "2026-03-02T14:37:37.540352", "datastore_active": false, "description": "Dicion\u00e1rio de Dados do Di\u00e1rio Oficial a partir de 2017.", "format": "JSON", "hash": "", "id": "3dfee877-f92a-4d0b-81f3-9f68fca9b227", "last_modified": "2026-11-10T21:34:23.393087", "metadata_modified": "2026-11-10T21:34:23.565647", "mimetype": "application/json", "mimetype_inner": null, "name": "Dicion\u00e1rio de Dados do Di\u00e1rio Oficial a partir de 2017", "package_id": "12578535-6cf0-4097-94fa-ff6ec3d51988", "position": 0, "resource_type": null, "size": 4739, "state": "active", "url": "https://dados.recife.pe.gov.br:443/dataset/12578535-6cf0-4097-94fa-ff6ec3d51988/resource/3dfee877-f92a-4d0b-81f3-9f68fca9b227/download/dicionario-de-dados-do-diario-oficial-a-partir-de-2017.json", "url_type": "upload"}, {"cache_last_updated": null, "cache_url": null, "created": "2026-11-09T16:45:48.639346", "datastore_active": true, "description": "Descri\u00e7\u00e3o e link para os di\u00e1rios Oficiais do ano de 2026. Para acessar o link, clicar com o bot\u00e3o direito do mouse escolher a op\u00e7\u00e3o \"Abrir link em uma nova guia\".\r\n\r\nPara o conte\u00fado completo do di\u00e1rio oficial 2026 em formato aberto, acessar o link",