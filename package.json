{
  "name": "vereda",
  "main": "expo-router/entry",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "verificar": "npm run typecheck && npm run lint && npm test",
    "test:v1": "node scripts/v1-smoke.mjs",
    "camadas": "node scripts/dados/publicar-camadas.cjs",
    "eas-build-post-install": "node scripts/dados/publicar-camadas.cjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.26",
    "expo-asset": "~58.0.21",
    "expo-audio": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.16",
    "expo-dev-client": "~58.0.21",
    "expo-file-system": "~58.0.14",
    "expo-font": "~58.0.12",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.17",
    "expo-location": "~58.0.22",
    "expo-notifications": "~58.1.9",
    "expo-print": "~58.0.9",
    "expo-router": "~58.0.32",
    "expo-share-intent": "^9.0.0",
    "expo-sharing": "~58.0.23",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "14.0.1",
    "suncalc": "2.1.1",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "fast-check": "^4.10.2",
    "jest": "~30.5.2",
    "jest-environment-jsdom": "~30.5.2",
    "jest-expo": "~58.0.15",
    "playwright": "^1.64.1",
    "react-test-renderer": "19.3.0",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/tests/**/*.test.ts"
    ],
    "setupFiles": [
      "<rootDir>/tests/configurar-camadas.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/.claude/"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/.claude/"
    ],
    "moduleNameMapper": {
      "^zod$": "<rootDir>/node_modules/zod"
    },
    "moduleDirectories": [
      "node_modules",
      "<rootDir>/node_modules/expo/node_modules"
    ]
  }
}
